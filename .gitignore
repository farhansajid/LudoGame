# ==========================================
# Royal Ludo - Production .gitignore
# ==========================================

# Teamwork and Agent Metadata (CRITICAL)
.agents/
.gemini/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Environment Variables & Secrets
.env
.env.*
*.local
*.secret

# OS & Editor Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Node.js & Capacitor tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android Native Build Artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml
android/captures/
.externalNativeBuild/
.cxx/

# Package & Keystore files
*.apk
*.ap_
*.aab
*.dex
*.keystore
*.jks

# Temporary and Log files
*.log
*.tmp
temp/
tmp/
